# ==============================================================================
# YEC Market Backend — Environment Variables Template
# ==============================================================================
# MUHIM: Ushbu faylda haqiqiy parollar va maxfiy kalitlarni saqlamang!
# Haqiqiy qiymatlarni faqat lokal .env yoki Render Environment Variables sozlamalariga kiriting.

# Database (PostgreSQL / Neon)
# Render Dashboard'ga kiritishda qo'shtirnoqsiz (quotesiz) kiriting!
# Misol: postgresql://user:password@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/yec_market?schema=public"
DB_POOL_MAX=20

# Server Ports, Host & Storage
PORT=3001
HOST="0.0.0.0"
REQUEST_TIMEOUT_MS=45000
UPLOADS_DIR="./uploads"

# Auth & JWT Secrets
JWT_SECRET="replace-with-a-very-strong-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-another-strong-random-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URLs (vergul bilan bir nechta domen ajratilishi mumkin)
FRONTEND_URL="http://localhost:3000,https://yec-market.vercel.app"

# Google OAuth (Web & Mobile)
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-web-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"
GOOGLE_MOBILE_CLIENT_ID="your-google-mobile-client-id.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""

# SMTP Email (Gmail yoki boshqa provayder)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="YEC Market <no-reply@yecmarket.uz>"

# Telegram Bot (ixtiyoriy)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_ENABLED="false"
TELEGRAM_LAUNCH="false"

# Web Push Notifications (ixtiyoriy)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Redis / BullMQ (ixtiyoriy)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# SMS Gateway (Eskiz - ixtiyoriy)
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"

# Payment Gateways (ixtiyoriy)
CLICK_SECRET_KEY=""
PAYME_KEY=""
